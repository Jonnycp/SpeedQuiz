        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class GameSession {\n        +String code\n        +ObjectId hostId\n        +String hostUsername\n        +String status\n        +Number createdAt\n        +Number lastActivityAt\n        +Number currentRound\n        +Number currentVoting\n        +Number phaseEndAt\n        +ObjectId gameId\n        +Array~ObjectId~ questions\n    }\n\n    class Config {\n        &lt;&lt;embedded&gt;&gt;\n        +Boolean public\n        +Number rounds\n        +Number minPlayers\n        +Number maxPlayers\n        +Number answerTimeMs\n        +Number votingTimeMs\n        +Number revealTimeMs\n    }\n\n    class PlayerSession {\n        &lt;&lt;embedded, Map&gt;&gt;\n        +ObjectId id\n        +String username\n        +String socketId\n        +Boolean connected\n        +Number disconnectedAt\n        +Number score\n    }\n\n    class Timers {\n        &lt;&lt;embedded&gt;&gt;\n        +Timer answering\n        +Timer voting\n        +Timer reveal\n    }\n\n    class Match {\n        &lt;&lt;embedded, Array&gt;&gt;\n        +Object question\n        +Boolean isVoted\n    }\n\n    class MatchPlayer {\n        &lt;&lt;embedded&gt;&gt;\n        +ObjectId id\n        +String username\n        +Array~String~ answers\n        +Array~ObjectId~ votedBy\n        +Number score\n        +Boolean isWinner\n    }\n\n    %% Relazioni (Composizioni per i documenti embedded)\n    GameSession \&quot;1\&quot; *-- \&quot;1\&quot; Config : config\n    GameSession \&quot;1\&quot; *-- \&quot;*\&quot; PlayerSession : players (Map)\n    GameSession \&quot;1\&quot; *-- \&quot;1\&quot; Timers : timers\n    GameSession \&quot;1\&quot; *-- \&quot;*\&quot; Match : rounds (Map)\n    Match \&quot;1\&quot; *-- \&quot;1\&quot; MatchPlayer : p1\n    Match \&quot;1\&quot; *-- \&quot;1\&quot; MatchPlayer : p2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iTrzIZNziC28qEQrhmrO-1">
